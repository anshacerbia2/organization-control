# Copy to .env beside compose.yaml and fill in. .env is git-ignored; never commit it.

# The kernel's public issuer, exactly as its discovery document states it: the value identity-control's
# deploy/dev/.env holds.
KEYCLOAK_ISSUER=https://<the kernel host>/realms/scnehaux

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
# The five runtime login roles (scripts/login-roles.sql), one per pool, each its own credential.
ORGANIZATION_RUNTIME_PASSWORD=
ORGANIZATION_PROVIDER_PASSWORD=
ORGANIZATION_DISPATCH_PASSWORD=
ORGANIZATION_RESOLUTION_PASSWORD=
ORGANIZATION_CONSUMER_PASSWORD=

# The user the service runs as, and so the owner of its workload key in ./keys. The image's nonroot
# user unless you need another.
KEYS_OWNER=65532:65532

# The loopback port the API is published on.
ORGANIZATION_CONTROL_PORT=8083

# Delivery to the Identity Control API. Leave empty until README §Wiring to other services says to
# set it; the service then runs no dispatcher.
# ORGANIZATION_DELIVERY_TARGETS=identity-control=http://identity-control:8090/v1/deliveries
